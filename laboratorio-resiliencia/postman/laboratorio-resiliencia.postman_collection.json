{
  "info": {
    "name": "Laboratorio de resiliencia",
    "description": "Comprobación inicial. Los experimentos y solicitudes de negocio se agregan al resolver ejercicios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    }
  ],
  "item": [
    {
      "name": "00 - Salud de la aplicación",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Aplicación disponible', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    }
  ]
}

